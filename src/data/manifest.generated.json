[
  {
    "id": "1188-133604-0042",
    "text": "THE SCENE IS ABSOLUTELY ARCADIAN",
    "speakerId": "1188",
    "chapterId": "133604",
    "config": "clean",
    "split": "test",
    "rowIdx": 1813,
    "level": 1,
    "speakerMinutes": 8.2,
    "index": 0
  },
  {
    "id": "652-129742-0019",
    "text": "WHEN THICKENED STRAIN AND COOL",
    "speakerId": "652",
    "chapterId": "129742",
    "config": "clean",
    "split": "validation",
    "rowIdx": 2489,
    "level": 1,
    "speakerMinutes": 8.3,
    "index": 1
  },
  {
    "id": "672-122797-0028",
    "text": "THIS EVENING THEY ALL SAID",
    "speakerId": "672",
    "chapterId": "122797",
    "config": "clean",
    "split": "test",
    "rowIdx": 1557,
    "level": 1,
    "speakerMinutes": 8.3,
    "index": 2
  },
  {
    "id": "672-122797-0053",
    "text": "THEY WERE SO EXTREMELY CURIOUS",
    "speakerId": "672",
    "chapterId": "122797",
    "config": "clean",
    "split": "test",
    "rowIdx": 1582,
    "level": 1,
    "speakerMinutes": 8.3,
    "index": 3
  },
  {
    "id": "7127-75947-0005",
    "text": "I ALLUDE TO THE GODDESS",
    "speakerId": "7127",
    "chapterId": "75947",
    "config": "clean",
    "split": "test",
    "rowIdx": 431,
    "level": 1,
    "speakerMinutes": 8.3,
    "index": 4
  },
  {
    "id": "7127-75947-0020",
    "text": "NO MORE THAN THE DANCING",
    "speakerId": "7127",
    "chapterId": "75947",
    "config": "clean",
    "split": "test",
    "rowIdx": 446,
    "level": 1,
    "speakerMinutes": 8.3,
    "index": 5
  },
  {
    "id": "422-122949-0017",
    "text": "THIS IS THE PROBLEM OF RACE",
    "speakerId": "422",
    "chapterId": "122949",
    "config": "clean",
    "split": "validation",
    "rowIdx": 2508,
    "level": 1,
    "speakerMinutes": 8.4,
    "index": 6
  },
  {
    "id": "672-122797-0029",
    "text": "HOW IT WILL SHINE THIS EVENING",
    "speakerId": "672",
    "chapterId": "122797",
    "config": "clean",
    "split": "test",
    "rowIdx": 1558,
    "level": 1,
    "speakerMinutes": 8.3,
    "index": 7
  },
  {
    "id": "672-122797-0031",
    "text": "IT BLAZED UP FAMOUSLY HELP HELP",
    "speakerId": "672",
    "chapterId": "122797",
    "config": "clean",
    "split": "test",
    "rowIdx": 1560,
    "level": 1,
    "speakerMinutes": 8.3,
    "index": 8
  },
  {
    "id": "672-122797-0047",
    "text": "HOW KIND MAN IS AFTER ALL",
    "speakerId": "672",
    "chapterId": "122797",
    "config": "clean",
    "split": "test",
    "rowIdx": 1576,
    "level": 1,
    "speakerMinutes": 8.3,
    "index": 9
  },
  {
    "id": "672-122797-0060",
    "text": "IT IS A VERY STUPID STORY",
    "speakerId": "672",
    "chapterId": "122797",
    "config": "clean",
    "split": "test",
    "rowIdx": 1589,
    "level": 1,
    "speakerMinutes": 8.3,
    "index": 10
  },
  {
    "id": "7127-75946-0005",
    "text": "WHAT DO YOU MEAN INQUIRED LOUIS",
    "speakerId": "7127",
    "chapterId": "75946",
    "config": "clean",
    "split": "test",
    "rowIdx": 472,
    "level": 1,
    "speakerMinutes": 8.3,
    "index": 11
  },
  {
    "id": "5639-40744-0008",
    "text": "WHO TOUCHES ME AM I IN BED",
    "speakerId": "5639",
    "chapterId": "40744",
    "config": "clean",
    "split": "test",
    "rowIdx": 145,
    "level": 2,
    "speakerMinutes": 8.3,
    "index": 0
  },
  {
    "id": "672-122797-0014",
    "text": "WERE I BUT ALREADY ON THE CART",
    "speakerId": "672",
    "chapterId": "122797",
    "config": "clean",
    "split": "test",
    "rowIdx": 1543,
    "level": 2,
    "speakerMinutes": 8.3,
    "index": 1
  },
  {
    "id": "672-122797-0024",
    "text": "THE DEPARTURE WAS NOT AT ALL AGREEABLE",
    "speakerId": "672",
    "chapterId": "122797",
    "config": "clean",
    "split": "test",
    "rowIdx": 1553,
    "level": 2,
    "speakerMinutes": 8.3,
    "index": 2
  },
  {
    "id": "672-122797-0035",
    "text": "BUT I SHALL TELL ONLY ONE STORY",
    "speakerId": "672",
    "chapterId": "122797",
    "config": "clean",
    "split": "test",
    "rowIdx": 1564,
    "level": 2,
    "speakerMinutes": 8.3,
    "index": 3
  },
  {
    "id": "672-122797-0058",
    "text": "WHO IS HUMPY DUMPY ASKED THE MICE",
    "speakerId": "672",
    "chapterId": "122797",
    "config": "clean",
    "split": "test",
    "rowIdx": 1587,
    "level": 2,
    "speakerMinutes": 8.3,
    "index": 4
  },
  {
    "id": "672-122797-0054",
    "text": "I KNOW NO SUCH PLACE SAID THE TREE",
    "speakerId": "672",
    "chapterId": "122797",
    "config": "clean",
    "split": "test",
    "rowIdx": 1583,
    "level": 2,
    "speakerMinutes": 8.3,
    "index": 5
  },
  {
    "id": "7127-75946-0011",
    "text": "YOU WILL TAKE THEM FROM MY PRIVATE TREASURE",
    "speakerId": "7127",
    "chapterId": "75946",
    "config": "clean",
    "split": "test",
    "rowIdx": 478,
    "level": 2,
    "speakerMinutes": 8.3,
    "index": 6
  },
  {
    "id": "7127-75947-0030",
    "text": "SHE WAS HERE JUST NOW SAID THE COUNT",
    "speakerId": "7127",
    "chapterId": "75947",
    "config": "clean",
    "split": "test",
    "rowIdx": 456,
    "level": 2,
    "speakerMinutes": 8.3,
    "index": 7
  },
  {
    "id": "5639-40744-0011",
    "text": "SHE FOUND THE DOOR BUT IT WAS LOCKED OUTSIDE",
    "speakerId": "5639",
    "chapterId": "40744",
    "config": "clean",
    "split": "test",
    "rowIdx": 148,
    "level": 2,
    "speakerMinutes": 8.3,
    "index": 8
  },
  {
    "id": "422-122949-0002",
    "text": "WE TRUTHFUL ONES THE NOBILITY IN ANCIENT GREECE CALLED THEMSELVES",
    "speakerId": "422",
    "chapterId": "122949",
    "config": "clean",
    "split": "validation",
    "rowIdx": 2493,
    "level": 2,
    "speakerMinutes": 8.4,
    "index": 9
  },
  {
    "id": "422-122949-0028",
    "text": "AND WHOEVER THOU ART WHAT IS IT THAT NOW PLEASES THEE",
    "speakerId": "422",
    "chapterId": "122949",
    "config": "clean",
    "split": "validation",
    "rowIdx": 2519,
    "level": 2,
    "speakerMinutes": 8.4,
    "index": 10
  },
  {
    "id": "422-122949-0035",
    "text": "AND TO CHOOSE FOR COMPANY THAT ROGUISH AND CHEERFUL VICE POLITENESS",
    "speakerId": "422",
    "chapterId": "122949",
    "config": "clean",
    "split": "validation",
    "rowIdx": 2526,
    "level": 2,
    "speakerMinutes": 8.4,
    "index": 11
  },
  {
    "id": "3528-168656-0000",
    "text": "SHE HAD EVEN BEEN IN SOCIETY BEFORE THE REVOLUTION",
    "speakerId": "3528",
    "chapterId": "168656",
    "config": "other",
    "split": "test",
    "rowIdx": 864,
    "level": 3,
    "speakerMinutes": 10.3,
    "index": 0
  },
  {
    "id": "3528-168669-0044",
    "text": "SHE RETAINED HER CONSCIOUSNESS TO THE VERY LAST MOMENT",
    "speakerId": "3528",
    "chapterId": "168669",
    "config": "other",
    "split": "test",
    "rowIdx": 921,
    "level": 3,
    "speakerMinutes": 10.3,
    "index": 1
  },
  {
    "id": "3528-168669-0093",
    "text": "THE MOST FEROCIOUS BEASTS ARE BEASTS WHICH ARE BLIND",
    "speakerId": "3528",
    "chapterId": "168669",
    "config": "other",
    "split": "test",
    "rowIdx": 970,
    "level": 3,
    "speakerMinutes": 10.3,
    "index": 2
  },
  {
    "id": "3528-168669-0100",
    "text": "THE OFFICE FOR THE DEAD WILL THEN BE SAID",
    "speakerId": "3528",
    "chapterId": "168669",
    "config": "other",
    "split": "test",
    "rowIdx": 977,
    "level": 3,
    "speakerMinutes": 10.3,
    "index": 3
  },
  {
    "id": "3528-168669-0106",
    "text": "HE WILL PAY IT AT FOUR O'CLOCK TO DAY",
    "speakerId": "3528",
    "chapterId": "168669",
    "config": "other",
    "split": "test",
    "rowIdx": 983,
    "level": 3,
    "speakerMinutes": 10.3,
    "index": 4
  },
  {
    "id": "3528-168669-0108",
    "text": "BUT YOU DO NOT UNDERSTAND ANY OF THE PEALS",
    "speakerId": "3528",
    "chapterId": "168669",
    "config": "other",
    "split": "test",
    "rowIdx": 985,
    "level": 3,
    "speakerMinutes": 10.3,
    "index": 5
  },
  {
    "id": "3528-168669-0121",
    "text": "AFTER WHICH THERE WILL BE NO TRACE OF ANYTHING",
    "speakerId": "3528",
    "chapterId": "168669",
    "config": "other",
    "split": "test",
    "rowIdx": 998,
    "level": 3,
    "speakerMinutes": 10.3,
    "index": 6
  },
  {
    "id": "3660-172183-0025",
    "text": "I WILL DO LORD SAID SHE AS THOU SAYEST",
    "speakerId": "3660",
    "chapterId": "172183",
    "config": "other",
    "split": "validation",
    "rowIdx": 25,
    "level": 3,
    "speakerMinutes": 10.3,
    "index": 7
  },
  {
    "id": "3660-6517-0032",
    "text": "THE BILGE PUMP IS DEPENDENT ON THE MAIN ENGINE",
    "speakerId": "3660",
    "chapterId": "6517",
    "config": "other",
    "split": "validation",
    "rowIdx": 59,
    "level": 3,
    "speakerMinutes": 10.3,
    "index": 8
  },
  {
    "id": "3915-98647-0035",
    "text": "IT SEEMS MORE LIKE A BRIDAL THAN A BURIAL",
    "speakerId": "3915",
    "chapterId": "98647",
    "config": "other",
    "split": "validation",
    "rowIdx": 2046,
    "level": 3,
    "speakerMinutes": 10.3,
    "index": 9
  },
  {
    "id": "3997-180294-0022",
    "text": "HERE ARE MY ORDERS TO NIGHT AT THE VAUDEVILLE",
    "speakerId": "3997",
    "chapterId": "180294",
    "config": "other",
    "split": "test",
    "rowIdx": 1822,
    "level": 3,
    "speakerMinutes": 10.3,
    "index": 10
  },
  {
    "id": "3997-180297-0012",
    "text": "I LISTENED AND I GAZED AT MARGUERITE WITH ADMIRATION",
    "speakerId": "3997",
    "chapterId": "180297",
    "config": "other",
    "split": "test",
    "rowIdx": 1846,
    "level": 3,
    "speakerMinutes": 10.3,
    "index": 11
  },
  {
    "id": "3528-168656-0001",
    "text": "IT WAS HER PLEASURE AND HER VANITY TO DRAG IN THESE NAMES ON EVERY PRETEXT",
    "speakerId": "3528",
    "chapterId": "168656",
    "config": "other",
    "split": "test",
    "rowIdx": 865,
    "level": 4,
    "speakerMinutes": 10.3,
    "index": 0
  },
  {
    "id": "3528-168669-0012",
    "text": "AND A WOMAN IS NOT A MAN BUT MY BROTHER IS THE STRONG ONE THOUGH",
    "speakerId": "3528",
    "chapterId": "168669",
    "config": "other",
    "split": "test",
    "rowIdx": 889,
    "level": 4,
    "speakerMinutes": 10.3,
    "index": 1
  },
  {
    "id": "3660-172182-0006",
    "text": "BUT GERAINT HAS OVERTAKEN HIM AND AVENGED THE INSULT TO THE MAIDEN TO THE UTTERMOST",
    "speakerId": "3660",
    "chapterId": "172182",
    "config": "other",
    "split": "validation",
    "rowIdx": 69,
    "level": 4,
    "speakerMinutes": 10.3,
    "index": 2
  },
  {
    "id": "3660-172182-0008",
    "text": "I DO SAID HE HE TELLS ME THAT HE IS EDEYRN THE SON OF NUDD",
    "speakerId": "3660",
    "chapterId": "172182",
    "config": "other",
    "split": "validation",
    "rowIdx": 71,
    "level": 4,
    "speakerMinutes": 10.3,
    "index": 3
  },
  {
    "id": "3660-172183-0015",
    "text": "I WILL DO AS FAR AS I CAN LORD SAID SHE ACCORDING TO THY DESIRE",
    "speakerId": "3660",
    "chapterId": "172183",
    "config": "other",
    "split": "validation",
    "rowIdx": 15,
    "level": 4,
    "speakerMinutes": 10.3,
    "index": 4
  },
  {
    "id": "3660-6517-0019",
    "text": "THE SHIP WAS OVER TWO FEET BY THE STERN BUT THIS WILL SOON BE REMEDIED",
    "speakerId": "3660",
    "chapterId": "6517",
    "config": "other",
    "split": "validation",
    "rowIdx": 46,
    "level": 4,
    "speakerMinutes": 10.3,
    "index": 5
  },
  {
    "id": "3660-6517-0027",
    "text": "FROM THIS MOMENT ABOUT FOUR A M THE ENGINE ROOM BECAME THE CENTRE OF INTEREST",
    "speakerId": "3660",
    "chapterId": "6517",
    "config": "other",
    "split": "validation",
    "rowIdx": 54,
    "level": 4,
    "speakerMinutes": 10.3,
    "index": 6
  },
  {
    "id": "3660-6517-0033",
    "text": "ON ONE OCCASION I WAS WAIST DEEP WHEN STANDING ON THE RAIL OF THE POOP",
    "speakerId": "3660",
    "chapterId": "6517",
    "config": "other",
    "split": "validation",
    "rowIdx": 60,
    "level": 4,
    "speakerMinutes": 10.3,
    "index": 7
  },
  {
    "id": "3915-98647-0024",
    "text": "SO LONG AS THE COFFIN IS IN THE HOUSE IT MUST BE WATCHED OVER CONTINUALLY",
    "speakerId": "3915",
    "chapterId": "98647",
    "config": "other",
    "split": "validation",
    "rowIdx": 2035,
    "level": 4,
    "speakerMinutes": 10.3,
    "index": 8
  },
  {
    "id": "3997-180294-0004",
    "text": "I DON'T KNOW HOW IT IS BUT IT SEEMS TO ME AS IF I DO",
    "speakerId": "3997",
    "chapterId": "180294",
    "config": "other",
    "split": "test",
    "rowIdx": 1804,
    "level": 4,
    "speakerMinutes": 10.3,
    "index": 9
  },
  {
    "id": "3997-182399-0002",
    "text": "HE WAS CURIOUS ABOUT THAT BLACK HEADED COUSIN OF OL MISTAH BUZZARD VERY CURIOUS INDEED",
    "speakerId": "3997",
    "chapterId": "182399",
    "config": "other",
    "split": "test",
    "rowIdx": 1781,
    "level": 4,
    "speakerMinutes": 10.3,
    "index": 10
  },
  {
    "id": "4572-112381-0011",
    "text": "THE MONTH IS LOST IN TOIL AND PAIN AND NOW MY FRIENDS WHAT HOPES REMAIN",
    "speakerId": "4572",
    "chapterId": "112381",
    "config": "other",
    "split": "validation",
    "rowIdx": 2582,
    "level": 4,
    "speakerMinutes": 10.3,
    "index": 11
  },
  {
    "id": "3660-6517-0000",
    "text": "THE DATES SEEM UNIMPORTANT BUT THROUGHOUT THE PERIOD THE OFFICERS AND MEN OF THE SHIP HAVE BEEN UNREMITTINGLY BUSY",
    "speakerId": "3660",
    "chapterId": "6517",
    "config": "other",
    "split": "validation",
    "rowIdx": 27,
    "level": 5,
    "speakerMinutes": 10.3,
    "index": 0
  },
  {
    "id": "3660-6517-0017",
    "text": "A THIRD SLEDGE STANDS ACROSS THE BREAK OF THE POOP IN THE SPACE HITHERTO OCCUPIED BY THE AFTER WINCH",
    "speakerId": "3660",
    "chapterId": "6517",
    "config": "other",
    "split": "validation",
    "rowIdx": 44,
    "level": 5,
    "speakerMinutes": 10.3,
    "index": 1
  },
  {
    "id": "3915-57461-0000",
    "text": "WE HAVE SUCCEEDED IN AMASSING TWO HUNDRED OUNCES OF SILVER ENOUGH I TRUST TO ERECT A HANDSOME BRONZE FIGURE",
    "speakerId": "3915",
    "chapterId": "57461",
    "config": "other",
    "split": "validation",
    "rowIdx": 1980,
    "level": 5,
    "speakerMinutes": 10.3,
    "index": 2
  },
  {
    "id": "3915-57461-0020",
    "text": "ON MY JOURNEY HOMEWARDS I TOOK A LODGING IN THE NEXT STREET AND THERE HEARD OF YOUR MARVELLOUS AILMENT",
    "speakerId": "3915",
    "chapterId": "57461",
    "config": "other",
    "split": "validation",
    "rowIdx": 2000,
    "level": 5,
    "speakerMinutes": 10.3,
    "index": 3
  },
  {
    "id": "3915-98647-0002",
    "text": "THESE MUST BE KEPT CAREFULLY BY THE MOTHER AS A SAFEGUARD AGAINST THE MANY EVILS THAT BESET CHILD LIFE",
    "speakerId": "3915",
    "chapterId": "98647",
    "config": "other",
    "split": "validation",
    "rowIdx": 2013,
    "level": 5,
    "speakerMinutes": 10.3,
    "index": 4
  },
  {
    "id": "3997-182399-0013",
    "text": "WHY HE JES STRETCH HIS FOOL HAID AS FAR DOWN THAT CHIMNEY AS HE CAN AN LISTEN AN LISTEN",
    "speakerId": "3997",
    "chapterId": "182399",
    "config": "other",
    "split": "test",
    "rowIdx": 1792,
    "level": 5,
    "speakerMinutes": 10.3,
    "index": 5
  },
  {
    "id": "3660-172182-0028",
    "text": "AND HE GREETS THEE WELL AS AN UNCLE SHOULD GREET HIS NEPHEW AND AS A VASSAL SHOULD GREET HIS LORD",
    "speakerId": "3660",
    "chapterId": "172182",
    "config": "other",
    "split": "validation",
    "rowIdx": 91,
    "level": 5,
    "speakerMinutes": 10.3,
    "index": 6
  },
  {
    "id": "3660-6517-0006",
    "text": "THE MEN'S SPACE SUCH AS IT IS THEREFORE EXTENDS FROM THE FORE HATCH TO THE STEM ON THE MAIN DECK",
    "speakerId": "3660",
    "chapterId": "6517",
    "config": "other",
    "split": "validation",
    "rowIdx": 33,
    "level": 5,
    "speakerMinutes": 10.3,
    "index": 7
  },
  {
    "id": "3660-6517-0021",
    "text": "IT IS A PATHETIC ATTITUDE DEEPLY SIGNIFICANT OF COLD AND MISERY OCCASIONALLY SOME POOR BEAST EMITS A LONG PATHETIC WHINE",
    "speakerId": "3660",
    "chapterId": "6517",
    "config": "other",
    "split": "validation",
    "rowIdx": 48,
    "level": 5,
    "speakerMinutes": 10.3,
    "index": 8
  },
  {
    "id": "3915-57461-0016",
    "text": "NOW IT CHANCED THAT THE STORY REACHED THE EARS OF A CERTAIN WANDERING PRIEST WHO LODGED IN THE NEXT STREET",
    "speakerId": "3915",
    "chapterId": "57461",
    "config": "other",
    "split": "validation",
    "rowIdx": 1996,
    "level": 5,
    "speakerMinutes": 10.3,
    "index": 9
  },
  {
    "id": "3997-180294-0021",
    "text": "MY WHOLE BEING WAS EXALTED INTO JOY AT THE MEMORY OF THE WORDS WE HAD EXCHANGED DURING THAT FIRST NIGHT",
    "speakerId": "3997",
    "chapterId": "180294",
    "config": "other",
    "split": "test",
    "rowIdx": 1821,
    "level": 5,
    "speakerMinutes": 10.3,
    "index": 10
  },
  {
    "id": "3915-98647-0008",
    "text": "NO WELL MANAGED FAMILY WOULD THINK OF BUILDING A NEW HOUSE WITHOUT FINDING IN WHAT DIRECTION TO FACE THE FRONT DOOR",
    "speakerId": "3915",
    "chapterId": "98647",
    "config": "other",
    "split": "validation",
    "rowIdx": 2019,
    "level": 5,
    "speakerMinutes": 10.3,
    "index": 11
  }
]
